#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "keys_de.h"

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };

    behaviors {
        aumlaut: aumlaut {
            compatible = "zmk,behavior-tap-dance";
            label = "AUMLAUT";
            #binding-cells = <0>;
            bindings = <&kp DE_A>, <&kp DE_A_UMLAUT>;

            tapping-term-ms = <150>;
        };

        oumlaut: oumlaut {
            compatible = "zmk,behavior-tap-dance";
            label = "OUMLAUT";
            #binding-cells = <0>;
            bindings = <&kp DE_O>, <&kp DE_O_UMLAUT>;

            tapping-term-ms = <150>;
        };

        uumlaut: uumlaut {
            compatible = "zmk,behavior-tap-dance";
            label = "UUMLAUT";
            #binding-cells = <0>;
            bindings = <&kp DE_U>, <&kp DE_U_UMLAUT>;

            tapping-term-ms = <150>;
        };

        minusless: minusless {
            compatible = "zmk,behavior-tap-dance";
            label = "MINUSLESS";
            #binding-cells = <0>;
            bindings = <&kp DE_MINUS>, <&kp DE_LESS_THAN>;

            tapping-term-ms = <150>;
        };

        nav_left: nav_left {
            compatible = "zmk,behavior-tap-dance";
            label = "NAV_LEFT";
            #binding-cells = <0>;
            bindings =
                <&kp LEFT_ARROW>,
                <&kp LC(LEFT_ARROW)>,
                <&kp LG(LEFT_ARROW)>;

            tapping-term-ms = <150>;
        };

        mav_right: mav_right {
            compatible = "zmk,behavior-tap-dance";
            label = "MAV_RIGHT";
            #binding-cells = <0>;
            bindings =
                <&kp RIGHT_ARROW>,
                <&kp LC(RIGHT_ARROW)>,
                <&kp LG(RIGHT_ARROW)>;

            tapping-term-ms = <150>;
        };

        sz: sz {
            compatible = "zmk,behavior-tap-dance";
            label = "SZ";
            #binding-cells = <0>;
            bindings = <&kp DE_Z>, <&kp DE_SZ>;

            tapping-term-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwertz {
            display-name = "main keys";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  | PLAY  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp ESCAPE  &kp N1    &kp DE_N2  &kp DE_N3  &kp DE_N4  &kp DE_N5                          &kp DE_N6  &kp DE_N7  &kp DE_N8  &kp DE_N9  &kp DE_N0    &kp DE_QUESTION
&kp TAB     &kp DE_Q  &kp DE_W   &kp DE_E   &kp DE_R   &kp DE_T   &sz                                &uumlaut   &kp DE_I   &oumlaut   &kp DE_P     &kp BSPC
&tog 3      &aumlaut  &kp DE_S   &kp DE_D   &kp DE_F   &kp DE_G   &kp DE_H                           &kp DE_J   &kp DE_K   &kp DE_L   &kp DE_SEMI  &kp DE_SQT
&kp LSHFT   &kp DE_Y  &kp DE_X   &kp DE_C   &kp DE_V   &kp DE_B   &kp C_MUTE  &kp C_PLAY  &kp DE_N   &kp DE_M   &kp COMMA  &kp DOT    &minusless   &kp RSHFT
                      &kp LGUI   &kp LALT   &kp LCTRL  &tog 1     &kp RET     &kp SPACE   &mo 2      &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOL_DN>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        fnsigns {
            display-name = "function keys and signs";

            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &kp F1  &kp F2  &kp F3       &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans       &trans  &trans  &trans                  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &kp DE_HASH  &trans  &trans  &trans                  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &kp DE_PLUS  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
                &trans  &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        navigation {
            display-name = "navigation";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                       &trans  &trans     &trans    &trans      &trans   &trans
&trans      &kp INS       &kp PSCRN     &kp K_CMENU   &trans        &trans          &kp PG_UP                  &trans     &kp UP    &trans      &trans   &kp DELETE
&trans      &kp LALT      &kp LCTRL     &kp LSHFT     &trans        &kp CLCK        &kp PG_DN                  &nav_left  &kp DOWN  &mav_right  &kp DEL  &kp BSPC
&trans      &kp K_UNDO    &kp K_CUT     &kp K_COPY    &kp K_PASTE   &studio_unlock  &trans     &trans  &trans  &trans     &trans    &trans      &trans   &trans
                          &trans        &trans        &trans        &trans          &trans     &trans  &trans  &trans     &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp C_PREV C_NEXT>;
        };

        numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &kp DE_FSLH  &kp DE_ASTERISK  &kp DE_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                  &kp DE_N7  &kp DE_N8    &kp DE_N9        &kp DE_MINUS  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                  &kp DE_N4  &kp DE_N5    &kp DE_N6        &kp DE_EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DE_N1  &kp DE_N2    &kp DE_N3        &kp ENTER     &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &kp DE_N0    &kp COMMA
            >;
        };

        adjust_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "adjust";
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                             &none  &none  &none  &none  &none  &none
&ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &none                          &none  &none  &none  &none  &none
&none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none            &none                          &none  &none  &none  &none  &none
&none              &none            &none            &none            &none            &none            &rgb_ug RGB_TOG  &none  &none  &none  &none  &none  &none  &none
                                    &none            &none            &none            &none            &none            &none  &none  &none  &none  &none
            >;
        };
    };
};
